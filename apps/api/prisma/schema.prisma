generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

// One Ovrt merchant = one connected Shopify store + one connected Razorpay
// account. Deliberately minimal — no auth/org/RBAC beyond what a 30-hour
// demo needs; see DECISIONS.md.
model Merchant {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // nullable: a merchant created by an internal script (seed-demo.ts, the
  // eval scripts) has no login of its own — only ones that signed up
  // through the real auth flow do.
  passwordHash String?
  createdAt    DateTime @default(now())

  shopify  ShopifyConnection?
  razorpay RazorpayConnection?
}

model ShopifyConnection {
  id          String           @id @default(cuid())
  merchantId  String           @unique
  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shopDomain  String           @unique
  accessToken String // AES-256-GCM encrypted, format v1:<iv>:<tag>:<data>
  scope       String
  currency    String           @default("INR")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RazorpayConnection {
  id            String           @id @default(cuid())
  merchantId    String           @unique
  merchant      Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  keyId         String
  keySecret     String // AES-256-GCM encrypted
  webhookSecret String // AES-256-GCM encrypted
  accountId     String?
  currency      String           @default("INR")
  status        ConnectionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ── append-only ingest — the source of truth (PRD §6, §13 invariant 2) ──

model RawEvent {
  id                String    @id @default(cuid())
  merchantId        String
  source            String // 'shopify' | 'razorpay'
  eventType         String
  externalId        String
  payload           Json
  receivedAt        DateTime  @default(now())
  signatureVerified Boolean
  // nullable "claimed" marker — what SELECT ... FOR UPDATE SKIP LOCKED
  // filters on. Not in the PRD's original sketch; without it, concurrent
  // workers have no way to know which rows are already spoken for.
  processedAt       DateTime?

  @@unique([source, externalId]) // dedup at the door
  @@index([merchantId, receivedAt])
  @@index([processedAt])
}

model FunnelEvent {
  id          String   @id @default(cuid())
  merchantId  String
  checkoutId  String
  customerRef String
  // Raw contact info, not just customerRef — the join scorer matches on
  // these directly, and recovery outreach needs a real phone/email to send
  // to, not a hash. Nullable: only checkout_start rows populate them today.
  customerEmail String?
  customerPhone String?
  stage       String // session|product_view|add_to_cart|checkout_start|payment_attempt|payment_success|fulfilled
  occurredAt  DateTime
  amountPaise BigInt
  // unique so resolving the same RawEvent twice is a safe no-op, not a
  // duplicate row — needed for resolveShopifyEvent's upsert to work at all.
  rawEventId  String @unique

  @@index([merchantId, checkoutId])
}

model PaymentAttempt {
  id               String   @id @default(cuid())
  merchantId       String
  rzpPaymentId     String   @unique
  rzpOrderId       String
  checkoutId       String?
  joinConfidence   Decimal?
  joinMethod       String // 'notes' | 'fuzzy' | 'none'
  method           String
  status           String
  amountPaise      BigInt
  // when the attempt actually happened — not in the PRD's original sketch,
  // but ISSUER_DOWNTIME detection (§5) is impossible without it: there's no
  // way to check "did this failure happen during a downtime window" blind.
  attemptedAt      DateTime @default(now())
  errorCode        String?
  errorDescription String?
  errorSource      String?
  errorStep        String?
  errorReason      String?

  @@index([merchantId, checkoutId])
}

model DowntimeWindow {
  id         String    @id @default(cuid())
  method     String
  issuer     String
  severity   String
  startedAt  DateTime
  resolvedAt DateTime?
}

// no evidence, no leak — CHECK (cardinality(evidenceEventIds) > 0) added via
// a raw migration; Prisma doesn't express CHECK constraints natively.
model Leak {
  id               String   @id @default(cuid())
  merchantId       String
  class            String // see PRD §5 — the six leak classes
  amountPaise      BigInt
  checkoutId       String?
  evidenceEventIds String[]
  confidence       Decimal
  detectedAt       DateTime @default(now())

  @@index([merchantId, class, detectedAt])
}

model Diagnosis {
  id               String   @id @default(cuid())
  leakId           String
  diagnosisClass   String
  confidence       Decimal
  source           String // 'rules' | 'llm'
  modelName        String?
  evidenceEventIds String[]
  latencyMs        Int
}

// status-scoped idempotency lock — the reservation IS the concurrency
// control (PRD §9 invariant 1), not app-level discipline.
model RecoveryAction {
  id             String    @id @default(cuid())
  merchantId     String
  checkoutId     String
  leakId         String
  actionClass    String
  state          String // 'RESERVED' | 'DISPATCHED' | 'FAILED'
  idempotencyKey String
  evPaise        BigInt
  shieldVerdict  String
  shieldReason   String?
  rzpRef         String?
  dispatchedAt   DateTime?
  createdAt      DateTime  @default(now())

  // Deliberately NOT @@unique — Prisma can't express the actual invariant
  // (status-scoped, matching the AnalystJob-style pattern in PRD §9): only
  // one RESERVED-or-DISPATCHED row per (merchant, checkout, class) at a
  // time, but a FAILED row shouldn't block a fresh retry. The real
  // constraint is a partial unique index in manual-constraints.sql.
  @@index([merchantId, checkoutId, actionClass])
}

model LedgerEntry {
  seq        BigInt   @id @default(autoincrement())
  merchantId String
  prevHash   String
  payload    Json
  hash       String   @unique
  createdAt  DateTime @default(now())
}

model Outcome {
  id                String   @id @default(cuid())
  actionId          String
  recoveredPaise    BigInt
  attributedAt      DateTime
  attributionMethod String
}

// Recovery-conversation handling (PRD §8's reply classification, made
// real): a customer's reply to a recovery message gets classified, and
// anything needing a human — REFUSE, or anything the classifier can't
// place — becomes a ticket. PROMISE/DONE are positive signals that don't
// need one.
model Ticket {
  id               String   @id @default(cuid())
  merchantId       String
  recoveryActionId String
  replyText        String
  replyClass       String // 'PROMISE' | 'DONE' | 'REFUSE' | 'OPTOUT' | 'UNCLEAR'
  status           String   @default("OPEN") // 'OPEN' | 'RESOLVED'
  createdAt        DateTime @default(now())
}

// An OPTOUT reply writes here, and Shield's check 1 (absolute, no
// override) reads from here — this is what makes "the customer said stop"
// actually stop future contact, not just get logged.
model OptOut {
  id         String   @id @default(cuid())
  merchantId String
  phone      String
  createdAt  DateTime @default(now())

  @@unique([merchantId, phone])
}

// The agent harness: every agent invocation — deterministic or
// LLM-assisted — writes one row here. This is what lets a founder click
// into any agent on /recovery/agents and see exactly what it actually did
// on a given run, not just trust the registry's description string.
model AgentRun {
  id         String   @id @default(cuid())
  merchantId String
  agentId    String // matches AGENT_REGISTRY's id, e.g. "opportunities"
  status     String // 'ok' | 'error'
  summary    String // one-line human-readable result, for the run-list view
  input      Json
  output     Json?
  error      String?
  durationMs Int
  startedAt  DateTime @default(now())

  @@index([merchantId, agentId, startedAt])
}

// "Chat with your store" — one thread per conversation; messages keep the
// full history (including which tools got called) so a multi-turn
// conversation can be replayed, not just the latest exchange.
model ChatThread {
  id         String   @id @default(cuid())
  merchantId String
  title      String?
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // 'user' | 'assistant' | 'tool'
  content   String
  toolCalls Json?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}
